def transport():
    from phase2.core import corpus, json_bytes, render_prompt
    from phase2.integration import validate_v4
    plan = load(FINAL / "execution_plan_v5.json")
    validate_v4(plan)
    _, members = corpus()
    jobs = {j["job_id"]: j for j in plan["jobs"]}
    inventory = load(FINAL / "end_to_end_mock_files.json")["files"]
    validation = load(FINAL / "end_to_end_validation.json")
    records, payloads, seen = {}, {}, set()
    path_b_count = 0
    with tarfile.open(FINAL / "end_to_end_mock.tar.gz", "r:gz") as archive:
        for member in archive:
            if not member.isfile() or member.name not in inventory or member.name in seen:
                raise RuntimeError("Unexpected archived checkpoint")
            seen.add(member.name)
            with archive.extractfile(member) as stream:
                raw = stream.read()
            if hashlib.sha256(raw).hexdigest() != inventory[member.name]["sha256"] or len(raw) != inventory[member.name]["bytes"]:
                raise RuntimeError("Archived evidence bytes changed")
            parts = member.name.split("/")
            if len(parts) != 4 or parts[1] != "checkpoints":
                continue
            ident, name = parts[2:]
            job = jobs[ident]
            data = json.loads(raw)
            if name == "result.json":
                records[ident] = data
            elif name == "payload.json":
                payloads[ident] = data["payload"]
            elif name == "intent.json":
                if data["job"] != job or data["manifest_sha256"] != plan["manifest_sha256"] or data["mode"] != "mock":
                    raise RuntimeError("Archived intent/implementation mismatch")
            elif name == "raw.json" and job["mechanism"] == "carl_jev":
                p = data["provenance"]
                if (data["error"] is not None or p["transport_attempts"] != 0 or p["live_calls"] != 0
                        or p["cli_invocations"] != 3 or p["cli_launch_attempts"] != 3 or p["replay_exit_status"] != 0
                        or p["usage_source"] != "verified_receipt.raw_response.usage"):
                    raise RuntimeError("Mock Path B transport/provenance mismatch")
                receipt_bytes = base64.b64decode(data["stdout"], validate=True)
                if hashlib.sha256(receipt_bytes).hexdigest() != p["receipt_sha256"]:
                    raise RuntimeError("Receipt anchor changed")
                receipt = json.loads(receipt_bytes)
                response_bytes = base64.b64decode(receipt["raw_response"], validate=True)
                if hashlib.sha256(response_bytes).hexdigest() != receipt["response_sha256"]:
                    raise RuntimeError("Receipt response changed")
                body = json.loads(response_bytes)
                if data["usage"] != body["usage"] or receipt["implementation_sha256"] != plan["config"]["adversaries"]["carl_jev"]["binary_sha256"]:
                    raise RuntimeError("Raw token usage or binary provenance mismatch")
                expected = {key: answer["noul"] for key, answer in body["answers"].items()}
                if receipt["result"]["signals"] != expected or receipt["result"]["reported_model"] != body["model"]:
                    raise RuntimeError("Policy altered underlying evidence")
                path_b_count += 1
    if seen != set(inventory) or len(records) != 6885 or len(payloads) != 6885 or path_b_count != 1215:
        raise RuntimeError("Incomplete full-chain archive")
    for ident, record in records.items():
        job = jobs[ident]
        if record["mode"] != "mock" or record["status"] != "mock_ok" or record["manifest_sha256"] != plan["manifest_sha256"]:
            raise RuntimeError("Non-mock or unsuccessful record in mock validation")
        parents = {p: inventory["end_to_end_mock/checkpoints/" + p + "/result.json"]["sha256"]
                   for p in job["dependencies"]}
        if record["parent_checkpoint_sha256"] != parents:
            raise RuntimeError("Archived parent lineage mismatch")
        for filename, expected in record["artifact_sha256"].items():
            if inventory["end_to_end_mock/checkpoints/" + ident + "/" + filename]["sha256"] != expected:
                raise RuntimeError("Archived result artifact binding mismatch")
        if job["kind"] != "generator":
            continue
        if not record["parsed"]["claims"]:
            raise RuntimeError("Empty mock assessment")
        parent = job["assessment_parent"]
        previous = records[parent]["parsed"] if parent else None
        history = []
        while parent:
            ancestor = jobs[parent]
            if ancestor["arm"] not in ("B0", job["arm"]):
                raise RuntimeError("Cross-branch assessment history")
            history.append({"assessment": records[parent]["parsed"], "challenge": records[parent].get("challenge_used"),
                            "source_sha256": ancestor["input_sha256"]})
            parent = ancestor["assessment_parent"]
        history.reverse()
        challenge = records[job["challenge_parent"]]["parsed"] if job["challenge_parent"] else None
        if payloads[ident] != render_prompt(plan, job, members[job["input_member"]], previous, history, challenge):
            raise RuntimeError("Generator prompt does not match frozen instruments and its own branch")
    group_key = lambda job: (job["case_id"], job["variant_id"], job["generator"], job["repetition"])
    paired = collections.defaultdict(dict)
    turns = {arm: collections.defaultdict(list) for arm in ("C3", "E3_NC", "E3_CN")}
    for job in plan["jobs"]:
        key = group_key(job)
        if job["kind"] == "generator" and job["arm"] in turns:
            turns[job["arm"]][key].append(job["turn"])
        if job["kind"] == "adversary" and job["arm"] in ("E1", "E2"):
            payload = payloads[job["job_id"]]
            paired[key][job["arm"]] = json_bytes(payload) if job["arm"] == "E1" else base64.b64decode(payload["native_request"], validate=True)
    if len(paired) != 405 or any(set(pair) != {"E1", "E2"} or pair["E1"] != pair["E2"] for pair in paired.values()):
        raise RuntimeError("Matched independent native/Path B request evidence differs")
    if any(len(groups) != 405 or any(sorted(values) != [1, 2] for values in groups.values()) for groups in turns.values()):
        raise RuntimeError("Both E3 orders and matched C3 turns not complete")
    if validation["resume"]["new_checkpoints"] != 0 or validation["blinded"]["exported_pairs"] != 2835:
        raise RuntimeError("Resume or blinded export incomplete")
    report = {"schema": "mmmtap-transport-provenance-validation-v1",
        "implementation_sha256": plan["implementation_sha256"], "instruments_sha256": plan["instruments_sha256"],
        "evidence_class": "complete_labelled_mock_chains_plus_offline_failure_regressions",
        "archive": "v5/end_to_end_mock.tar.gz", "archive_sha256": sha(FINAL / "end_to_end_mock.tar.gz"),
        "archive_entries_individually_verified": len(seen), "checkpoints": len(records),
        "generator_assessments": sum(j["kind"] == "generator" for j in jobs.values()),
        "native_mock_evaluations": 1215, "path_b_offline_policy_replays": path_b_count,
        "path_b_started_CLI_invocations": 3 * path_b_count, "HTTP_attempts_in_mock_run": 0, "live_provider_calls": 0,
        "structured_usage_verified_against_raw_receipt": True,
        "matched_independent_E1_E2_request_pairs": len(paired),
        "both_E3_orders_and_C3": {arm: {"groups": len(groups), "turns_each": [1, 2]} for arm, groups in turns.items()},
        "frozen_prompt_and_own_branch_history_verified_for_every_generator": True,
        "resume_new_checkpoints": 0, "blinded_pairs": 2835,
        "failure_regressions": ["no_credentials_zero_HTTP_attempts", "launch_failure_not_CLI_invocation",
            "incomplete_evaluation_unknown_count", "failed_preparation_artifacts", "staging_failure_exact_request",
            "malformed_receipt", "missing_response_file", "checksum_anchor_mismatch", "cleanup_failure_preserved",
            "literal_and_nested_encoded_credential_withholding", "preparation_checkpoint_before_payload",
            "same_workspace_cross_directory_reservation", "failed_parent_preparation_stays_reserved"],
        "limits": ["CLI invocation is not an HTTP attempt; a written request is not proven provider execution or billing.",
                   "Known-secret withholding is not a detector for every unknown secret or encoding.",
                   "Workspace reservations do not establish distributed/provider exactly-once execution.",
                   "All mock claims, token counts and challenge effects are authored fixtures, not research results."]}
    write(OUT / "TRANSPORT_PROVENANCE_VALIDATION.json", report)
    print(json.dumps({key: report[key] for key in ("checkpoints", "archive_entries_individually_verified",
                                                 "path_b_offline_policy_replays", "blinded_pairs")}))


