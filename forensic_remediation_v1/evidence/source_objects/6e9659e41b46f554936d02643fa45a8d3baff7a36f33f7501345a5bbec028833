def sha(path):
    with Path(path).open("rb") as stream:
        return hashlib.file_digest(stream, "sha256").hexdigest()


def load(path):
    return json.loads(Path(path).read_bytes())


def write(path, obj):
    with Path(path).open("x") as stream:
        json.dump(obj, stream, indent=2, sort_keys=True, allow_nan=False)
        stream.write("\n")


def copy_new(source, target):
    target.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    with source.open("rb") as src, target.open("xb") as dst:
        shutil.copyfileobj(src, dst)
    target.chmod(0o600)
    if sha(source) != sha(target):
        raise RuntimeError("Evidence copy mismatch")


def provider_shape():
    path = ROOT / "adapter_qualification_v1/attempts/native_jev/raw.json"
    raw = base64.b64decode(load(path)["stdout"], validate=True)
    obj = json.loads(raw)
    known = {"model", "answers", "usage"}
    counters = {"input_tokens", "output_tokens", "cached_input_tokens", "cache_write_tokens", "total_tokens"}
    fields = {"noul", "choice", "probabilities"}
    report = {
        "evidence_class": "read_only_historical_response_shape_not_new_provider_call",
        "file": str(path.relative_to(ROOT)), "file_sha256": sha(path),
        "response_sha256": hashlib.sha256(raw).hexdigest(),
        "recognized_root_fields": sorted(set(obj) & known), "unrecognized_root_field_count": len(set(obj) - known),
        "model_type": type(obj.get("model")).__name__, "usage_type": type(obj.get("usage")).__name__,
        "recognized_usage_fields": sorted(set(obj.get("usage") or {}) & counters),
        "unrecognized_usage_field_count": len(set(obj.get("usage") or {}) - counters),
        "answer_field_sets": sorted({",".join(sorted(set(a) & fields)) for a in obj["answers"].values()}),
        "unrecognized_answer_field_count": sum(len(set(a) - fields) for a in obj["answers"].values()),
    }
    if any(report[key] for key in ("unrecognized_root_field_count", "unrecognized_usage_field_count",
                                   "unrecognized_answer_field_count")):
        raise RuntimeError("Observed provider fields need explicit schema review")
    write(BASE / "observed_provider_shape.json", report)
    print(json.dumps(report))


def preservation():
    from phase2.core import corpus
    result = {"schema": "mmmtap-preservation-checks-v1", "producer_sha256": sha(__file__),
              "baseline_sha256": sha(BASELINE / "baseline.json"), "roots": {}}
    for label, root, allowed in (("workspace", ROOT, WORKSPACE_EDITS), ("carl", CARL, CARL_EDITS)):
        inventory_path = BASELINE / (label + "_inventory.json")
        inventory = load(inventory_path)
        changed, removed, unexpected, unchanged = [], [], [], 0
        for name, expected in inventory.items():
            path = root / name
            if not path.exists() and not path.is_symlink():
                removed.append(name)
                continue
            if expected["type"] == "file":
                same = not path.is_symlink() and path.is_file() and sha(path) == expected["sha256"]
            else:
                same = path.is_symlink() and str(path.readlink()) == expected["target"]
            same = same and (path.lstat().st_mode & 0o777) == expected["mode"]
            if same:
                unchanged += 1
            else:
                changed.append(name)
                if name not in allowed:
                    unexpected.append(name)
        additions = []
        for path in root.rglob("*"):
            name = str(path.relative_to(root))
            if label == "workspace" and path.is_relative_to(OUT):
                continue
            if ".git" in path.relative_to(root).parts and name != ".git":
                continue
            if (path.is_file() or path.is_symlink()) and name not in inventory:
                additions.append(name)
                if name not in allowed:
                    unexpected.append(name)
        if removed or unexpected:
            raise RuntimeError(json.dumps({"root": label, "removed": removed, "unexpected": unexpected}))
        result["roots"][label] = {"baseline_inventory_sha256": sha(inventory_path),
            "baseline_entries": len(inventory), "unchanged_entries": unchanged,
            "approved_source_or_documentation_changes": sorted(changed), "approved_additions": sorted(additions),
            "missing": removed, "unexpected_changes": unexpected}
    source, members = corpus()
    result["primary_inputs"] = {"identities": len(source["items"]),
        "distinct_input_hashes": len({i["input_sha256"] for i in source["items"]}),
        "archive_sha256": source["archive_sha256"], "actual_archive_reopened_and_verified": True,
        "all_members_match": all(hashlib.sha256(members[i["input_member"]]).hexdigest() == i["input_sha256"]
                                 for i in source["items"])}
    if result["primary_inputs"]["identities"] != 135 or result["primary_inputs"]["distinct_input_hashes"] != 108:
        raise RuntimeError("Primary identity set changed")
    prior = (BASELINE / "source/workspace/phase2/adapters.py").read_text()
    current = (ROOT / "phase2/adapters.py").read_text()
    def segment(text):
        node = next(n for n in ast.parse(text).body if isinstance(n, ast.ClassDef) and n.name == "CarlJEVAdapter")
        return ast.get_source_segment(text, node).encode()
    path_a = Path.home() / "bin/carl-jev"
    expected_binary = load(BASELINE / "baseline.json")["installed_path_a"]["sha256"]
    before, after = segment(prior), segment(current)
    protected_go = {name: entry["sha256"] for name, entry in load(BASELINE / "carl_inventory.json").items()
                    if name.endswith(".go") and not name.startswith("internal/assessment/")}
    result["path_a"] = {"installed_binary": str(path_a), "before_sha256": expected_binary,
        "after_sha256": sha(path_a), "python_CarlJEVAdapter_before_sha256": hashlib.sha256(before).hexdigest(),
        "python_CarlJEVAdapter_after_sha256": hashlib.sha256(after).hexdigest(),
        "protected_Go_sources": len(protected_go),
        "all_protected_Go_sources_unchanged": all(sha(CARL / name) == ident for name, ident in protected_go.items())}
    if sha(path_a) != expected_binary or before != after or not result["path_a"]["all_protected_Go_sources_unchanged"]:
        raise RuntimeError("Path A changed")
    result["historical_evidence"] = {
        name: {"unchanged": True, "files": sum(p.startswith(name + "/") for p in load(BASELINE / "workspace_inventory.json"))}
        for name in ("independent_forensic_review_v1", "integration_readiness_v1", "adapter_qualification_v1",
                     "carl_jev_cli_investigation_v1", "path_b_validation_v1", "execution_dry_run_v2")}
    result["historical_plans"] = {name: sha(ROOT / name) for name in
        ("execution_plan_v2.json", "integration_readiness_v1/execution_plan_v3.json")}
    command = ["git", "--no-pager", "status", "--short", "--branch"]
    result["current_git"] = {"carl_status": subprocess.run(command, cwd=CARL, capture_output=True, text=True,
                                                         check=True).stdout,
                            "carl_head": subprocess.run(["git", "rev-parse", "HEAD"], cwd=CARL, capture_output=True,
                                                       text=True, check=True).stdout.strip(),
                            "workspace": "not_a_git_repository"}
    if result["current_git"]["carl_head"] != load(BASELINE / "baseline.json")["git"]["carl"]["head"]["stdout"].strip():
        raise RuntimeError("Git HEAD changed")
    write(OUT / "PRESERVATION_CHECKS.json", result)
    print(json.dumps({"roots": result["roots"], "primary_inputs": result["primary_inputs"], "path_a": result["path_a"]}))


def copy_evidence():
    target = OUT / "evidence"
    target.mkdir(mode=0o700, exist_ok=False)
    for path in sorted(BASELINE.rglob("*")):
        if path.is_file():
            copy_new(path, target / "baseline" / path.relative_to(BASELINE))
    for directory in (BASE / "command_evidence").iterdir():
        if not (directory / "command.json").is_file():
            raise RuntimeError("Command still running or missing completion evidence: " + directory.name)
        for path in directory.iterdir():
            if path.is_file():
                copy_new(path, target / "commands" / directory.name / path.name)
    needed = set()
    for path in (target / "commands").glob("*/command.json"):
        record = load(path)
        needed.update(record["source_sha256"].values())
        if record.get("runner_source_sha256"):
            needed.add(record["runner_source_sha256"])
    recovery = load(BASE / "source_recovery.json")
    needed.update(r["runner_source_from_recorded_edit_timing"] for r in recovery["commands"].values()
                  if r.get("runner_source_from_recorded_edit_timing"))
    for ident in sorted(needed):
        if sha(BASE / "source_objects" / ident) != ident:
            raise RuntimeError("Missing or incorrect original command source object")
        copy_new(BASE / "source_objects" / ident, target / "source_objects" / ident)
    for name in ("capture_baseline.py", "offline_run.py", "recover_command_sources.py", "publish_evidence.py"):
        copy_new(BASE / name, target / "tools" / name)
    for name in ("source_recovery.json", "observed_provider_shape.json"):
        copy_new(BASE / name, target / name)
    for name in ("expanded_control_probe", "expanded_controls_v2"):
        for path in (BASE / name).rglob("*"):
            if path.is_file():
                copy_new(path, target / "development_controls" / name / path.relative_to(BASE / name))
    print(json.dumps({"source_objects": len(needed), "copied_commands": len(list((target / "commands").iterdir()))}))


def command(label):
    folder = OUT / "evidence/commands" / label
    record = load(folder / "command.json")
    if sha(folder / "stdout.txt") != record["stdout_sha256"] or sha(folder / "stderr.txt") != record["stderr_sha256"]:
        raise RuntimeError("Command evidence changed")
    if not record["source_unchanged_during_command"]:
        raise RuntimeError("Source changed during a validation command")
    return folder, record


def results():
    from phase2.adapters import parse_systemone
    from phase2.core import digest
    from phase2.integration import verify_instruments, validate_v4
    from phase2.isolation_controls import validate_controls
    cfg = verify_instruments(OUT / "instruments")
    plan = load(OUT / "execution_plan_v4.json")
    validate_v4(plan)
    controls = validate_controls(OUT / "isolation_controls_final", OUT / "instruments")
    software = load(OUT / "instruments/software.v1.json")
    binding = {"implementation_sha256": plan["implementation_sha256"], "instruments_sha256": plan["instruments_sha256"],
               "execution_plan_file": "execution_plan_v4.json", "execution_plan_sha256": sha(OUT / "execution_plan_v4.json"),
               "execution_plan_manifest_sha256": plan["manifest_sha256"],
               "path_b_binary_sha256": cfg["adversaries"]["carl_jev"]["binary_sha256"]}
    final_labels = ("final-python-suite", "final-go-suite-and-vet", "final-bound-build-and-freeze",
                    "final-bound-isolation-controls", "final-full-mock-and-plan", "final-reproducible-build")
    final_commands = {}
    for label in final_labels:
        folder, record = command(label)
        normalized = {("mmmtap_phase2/" + name[10:] if name.startswith("workspace/") else
                       "cARL-semantic-eval/" + name[5:]): ident for name, ident in record["source_sha256"].items()}
        if record["exit_status"] != 0 or normalized != software["sources"]:
            raise RuntimeError("Final command failed or does not match sealed implementation: " + label)
        final_commands[label] = {"command_record": str((folder / "command.json").relative_to(OUT)),
                                 "command_record_sha256": sha(folder / "command.json"), "exit_status": 0,
                                 "elapsed_seconds": record["elapsed_seconds"]}
    py_text = (OUT / "evidence/commands/final-python-suite/stderr.txt").read_text()
    count = re.search(r"Ran (\d+) tests", py_text)
    if count is None or not py_text.rstrip().endswith("OK") or "skipped=" in py_text:
        raise RuntimeError("Full Python result not complete")
    go_lines = [json.loads(line) for line in (OUT / "evidence/commands/final-go-suite-and-vet/stdout.txt").read_text().splitlines()
                if line.startswith("{")]
    passed = [r for r in go_lines if r.get("Action") == "pass" and r.get("Test")]
    go_cases = {}
    for row in go_lines:
        if "MMMTAP_EQUIVALENCE " in row.get("Output", ""):
            observed = json.loads(row["Output"].split("MMMTAP_EQUIVALENCE ", 1)[1])
            go_cases[observed["id"]] = observed
    fixtures_path = CARL / "internal/assessment/testdata/systemone_responses.json"
    fixtures = load(fixtures_path)
    comparisons = []
    for case in fixtures["cases"]:
        raw = case["raw"].encode()
        try:
            evidence = parse_systemone(raw, fixtures["requests"][case["request"]])
            python = {"accepted": True, "evidence": {key: evidence[key] for key in ("resolved_model", "answers", "usage")}}
        except (ValueError, TypeError, KeyError, RecursionError):
            python = {"accepted": False, "evidence": None}
        go = go_cases[case["id"]]
        if python != {k: go[k] for k in ("accepted", "evidence")} or python["accepted"] != case["accepted"]:
            raise RuntimeError("Cross-language interpretation mismatch")
        comparisons.append({"id": case["id"], "question_kind": case["request"],
                            "raw_response_sha256": hashlib.sha256(raw).hexdigest(), **python,
                            "go_equals_native": True})
    write(OUT / "JEV_PATH_B_EQUIVALENCE.json", {
        "schema": "mmmtap-jev-path-b-equivalence-v1", **binding,
        "fixture_sha256": sha(fixtures_path), "fixture_classification": fixtures["evidence_mode"],
        "fixture_count": len(comparisons), "accepted": sum(c["accepted"] for c in comparisons),
        "all_underlying_interpretations_equal": True, "cases": comparisons,
        "policy": "Separate deterministic cARL policy preserved; threshold boundary tests and full frozen-policy mock receipts.",
        "choice_scope": "Shared parser coverage only; Path B's frozen request catalog remains noul-only.",
        "live_provider_calls": 0})
    red_labels = ("red-python-remediation", "red-go-remediation", "red-python-provenance-lifecycle",
                  "red-python-sealing-and-scope")
    red = {}
    for label in red_labels:
        folder, record = command(label)
        if record["exit_status"] == 0:
            raise RuntimeError("Pre-fix regression did not fail")
        red[label] = {"command_record": str((folder / "command.json").relative_to(OUT)),
                      "exit_status": record["exit_status"], "source_objects": "evidence/source_objects",
                      "hash_exact_original_sources_available": all((OUT / "evidence/source_objects" / value).is_file()
                                                                  for value in record["source_sha256"].values())}
    write(OUT / "REGRESSION_EVIDENCE.json", {
        "schema": "mmmtap-forensic-regression-evidence-v1", **binding, "evidence_class": "recorded_offline_commands",
        "red_before_fix": red, "final_commands": final_commands,
        "python": {"passed": int(count[1]), "skipped": 0},
        "go": {"top_level_passed": sum("/" not in r["Test"] for r in passed), "including_subtests_passed": len(passed),
               "packages_with_tests": len({r["Package"] for r in passed}), "vet": "passed",
               "formatting": "passed", "tracked_whitespace": "passed"},
        "development_failures_retained": ["evidence/commands/probe-expanded-cli-controls",
                                          "evidence/development_controls/expanded_control_probe"],
        "optional_race_check": "not_rerun; prior retained report documents unsupported 39-bit VMA; not claimed passed",
        "live_provider_calls": 0, "independent_live_qualification": "not_performed"})
    write(OUT / "ISOLATION_VALIDATION.json", {
        "schema": "mmmtap-isolation-validation-v1", **binding,
        "summary": "isolation_controls_final/summary.json", "summary_sha256": sha(OUT / "isolation_controls_final/summary.json"),
        "controls": len(controls["controls"]), "collection_and_containment_assertions": "passed",
        "qualification": controls["qualification"], "namespace": controls["namespace"],
        "observed_contract_failures": [{"name": r["name"], "failed_checks": [key for key, ok in r["strict_observed_checks"].items() if not ok],
                                       "HTTP_POSTs": r["post_count"], "positive_control": r["positive_control"]}
                                      for r in controls["controls"] if not all(r["strict_observed_checks"].values())],
        "limits": controls["limits"], "live_provider_calls": 0,
        "not_equivalent_to_live_model_qualification": True})
    write(OUT / "FROZEN_INSTRUMENT_VALIDATION.json", {
        "schema": "mmmtap-frozen-instrument-validation-v1", **binding,
        "manifest": "instruments/manifest.json", "software_manifest": "instruments/software.v1.json",
        "source_files_bound": len(software["sources"]), "runtime_and_snapshots_match": True,
        "question_semantics_changed": False, "policy_thresholds_changed": False, "scoring_contract_changed": False,
        "supersedes_without_modification": plan["supersedes"],
        "regressions": ["D2_changed_runtime_prompt_cannot_reuse_instrument_identity",
                        "D2_all_semantic_snapshots_must_match_runtime", "D2_unbound_old_binary_cannot_be_frozen_as_current",
                        "R1_imported_helpers_and_test_sources_are_bound", "R1_extra_or_changed_CLI_helpers_are_rejected",
                        "D6_stale_controls_cannot_reach_assembly_execution"],
        "limits": ["Hash-bound local provenance is not signed attestation.",
                   "Host OS/kernel/read-only /usr are not a hermetic runtime image.",
                   "Snapshots and example policy are proposed instruments, not PI approval."]})
    self_hash = sha(__file__)
    print(json.dumps({"binding": binding, "python_passed": int(count[1]), "go_passed_with_subtests": len(passed),
                      "shared_fixture_count": len(comparisons), "producer_sha256": self_hash}))


def main():
    os.umask(0o077)
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("operation", choices=("provider-shape", "preservation", "copy", "results"))
    args = parser.parse_args()
    {"provider-shape": provider_shape, "preservation": preservation, "copy": copy_evidence, "results": results}[args.operation]()


if __name__ == "__main__":
    main()
