"""Loopback-only adapter: cARL semantic HTTP contract -> hosted JEV SystemOne.
Native questions are retained. Maps boolean questions to hosted 'noul' 0..1 scores
and uses a documented >=0.5 mapping for boolean output. No cARL source changes.
"""
import json
import threading
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

MAX_BYTES = 3_000_000

def translate_request(data):
    state = data['state']
    questions = data['questions']
    transformed = {}
    for q in questions:
        kind = q['kind']
        ident = q['id']
        if kind == 'boolean':
            transformed[ident] = {'type':'noul', 'instructions':q['description']}
        elif kind == 'score':
            transformed[ident] = {'type':'noul', 'instructions':q['description']}
        elif kind == 'choice':
            choices = q.get('choices', [])
            if not choices: raise ValueError('Missing choices: '+ident)
            transformed[ident] = {'type':'choice', 'instructions':q['description'],
                                  'criteria':{v:v for v in choices}}
        else: raise ValueError('Unsupported question kind: '+kind)
    return {'model':data.get('model') or 'jev-latest',
            'state':json.dumps(state,sort_keys=True,ensure_ascii=False),
            'questions':transformed}

def translate_response(answer, original_questions):
    answers = answer.get('answers')
    if not isinstance(answers, dict):
        raise ValueError('Hosted JEV returned no answers object')
    normalized = {}
    for q in original_questions:
        ident=q['id']
        if ident not in answers: raise ValueError('Missing hosted JEV answer: '+ident)
        a=answers[ident]
        kind=q['kind']
        if kind in ('boolean','score'):
            score=a.get('noul')
            if not isinstance(score,(int,float)) or not 0<=score<=1:
                raise ValueError('Invalid noul score: '+ident)
            value = score>=0.5 if kind=='boolean' else float(score)
            normalized[ident]={'value':value,'confidence':float(score),
                               'metadata':{'raw_noul':float(score), 'bridge_threshold':0.5 if kind=='boolean' else None}}
        elif kind=='choice':
            choice=a.get('choice')
            if choice not in q.get('choices',[]):raise ValueError('Unexpected choice: '+ident)
            normalized[ident]={'value':choice,'confidence':a.get('confidence')}
    return {'answers':normalized}

class Bridge:
    def __init__(self,key,timeout,base_url='https://api.typesafe.ai'):
        self.key,self.timeout,self.base_url=key,timeout,base_url.rstrip('/')
        outer=self
        class Handler(BaseHTTPRequestHandler):
            def log_message(self,*args):pass
            def do_POST(self):
                if self.path!='/evaluate': self.send_error(404);return
                if self.headers.get('Authorization') != 'Bearer '+outer.key:
                    self.send_error(401);return
                try:
                    n=int(self.headers.get('Content-Length','0'))
                    if n<1 or n>MAX_BYTES: raise ValueError('Request size outside bounds')
                    original=json.loads(self.rfile.read(n))
                    payload=translate_request(original)
                    req=urllib.request.Request(outer.base_url+'/v1/systemone',
                        data=json.dumps(payload).encode(),method='POST',
                        headers={'Authorization':'Bearer '+outer.key,'Content-Type':'application/json',
                                 'Accept':'application/json','User-Agent':'mmmtap-carl-bridge/1.0'})
                    with urllib.request.urlopen(req,timeout=outer.timeout) as response:
                        hosted=json.loads(response.read(MAX_BYTES))
                    result=translate_response(hosted, original['questions'])
                    outer.stats={'model':hosted.get('model'), 'usage':hosted.get('usage'),
                                 'question_ids':[q['id'] for q in original['questions']]}
                    raw=json.dumps(result).encode()
                    self.send_response(200);self.send_header('Content-Type','application/json')
                    self.send_header('Content-Length',str(len(raw)));self.end_headers();self.wfile.write(raw)
                except Exception as e:
                    outer.error=type(e).__name__+': '+str(e).split('Bearer ')[0][:160]
                    # Do not relay provider response/error contents or keys.
                    self.send_error(502,'Hosted JEV bridge failure')
        self.server=ThreadingHTTPServer(('127.0.0.1',0),Handler)
        self.thread=threading.Thread(target=self.server.serve_forever,daemon=True)
        self.error=None;self.stats=None
    @property
    def endpoint(self):return f'http://127.0.0.1:{self.server.server_port}/evaluate'
    def __enter__(self):self.thread.start();return self
    def __exit__(self,*args):self.server.shutdown();self.server.server_close();self.thread.join(timeout=5)
